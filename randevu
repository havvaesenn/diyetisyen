    <!-- Interactive Scripting -->
    <script>
        // State variables
        let selectedFormat = 'Yüz Yüze Görüşme (Klinik)';
        let selectedDay = 'Perşembe (8 Eki)';
        let selectedSlot = '11:30';

        // Accordion Toggle
        function toggleAccordion(header) {
            const item = header.parentElement;
            item.classList.toggle('open');
        }

        // Format Selection
        function selectOption(card, formatName) {
            const container = card.parentElement;
            const cards = container.querySelectorAll('.option-card');
            cards.forEach(c => {
                c.classList.remove('selected');
                const badge = c.querySelector('.option-badge');
                if (badge) badge.remove();
            });

            card.classList.add('selected');
            const newBadge = document.createElement('span');
            newBadge.className = 'option-badge';
            newBadge.innerText = 'SEÇİLDİ';
            card.appendChild(newBadge);

            selectedFormat = formatName;
            updateSummary();
        }

        // Day Selection
        function selectDay(card, dayName) {
            const container = card.parentElement;
            const cards = container.querySelectorAll('.day-card:not(.disabled)');
            cards.forEach(c => c.classList.remove('selected'));

            card.classList.add('selected');
            selectedDay = dayName;
            updateSummary();
        }

        // Time Slot Selection
        function selectSlot(btn, timeSlot) {
            const container = btn.parentElement;
            const buttons = container.querySelectorAll('.slot-btn');
            buttons.forEach(b => b.classList.remove('selected'));

            btn.classList.add('selected');
            selectedSlot = timeSlot;
            updateSummary();
        }

        // Update Summary Text
        function updateSummary() {
            const summaryText = `${selectedFormat} • ${selectedDay} • ${selectedSlot}`;
            document.getElementById('summaryText').innerText = summaryText;
        }

        // WhatsApp Direct Submission
        function handleAppointmentSubmit(event) {
            event.preventDefault();

            const name = document.getElementById('fullName').value;
            const phone = document.getElementById('phoneNumber').value;
            const email = document.getElementById('emailAddress').value || 'Belirtilmedi';
            const goal = document.getElementById('goalSelect').value;
            const notes = document.getElementById('notes').value || 'Yok';

            const message = `Merhaba Dyt. Havva Nur Esen,%0A%0ARandevu talebim aşağıdadır:%0A%0A• *Görüşme Formatı:* ${selectedFormat}%0A• *Tarih & Saat:* ${selectedDay} - ${selectedSlot}%0A• *Ad Soyad:* ${name}%0A• *Telefon:* ${phone}%0A• *E-Posta:* ${email}%0A• *Hedef / İlgi Alanı:* ${goal}%0A• *Özel Durum / Not:* ${notes}`;

            const whatsappUrl = `https://wa.me/905303661720?text=${message}`;
            window.open(whatsappUrl, '_blank');
        }
    </script>
