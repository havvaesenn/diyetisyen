<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Randevu & Seans Planlama - Dyt. Havva Nur Esen</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-surface: #f9f9f9;
            --surface-container-lowest: #ffffff;
            --surface-container-low: #f3f3f3;
            --surface-container: #eeeeee;
            --surface-container-high: #e8e8e8;
            --surface-container-highest: #e2e2e2;
            --on-surface: #1b1b1b;
            --on-surface-variant: #444748;
            --outline: #747878;
            --outline-variant: #c4c7c8;
            --primary: #1b1b1b;
            --on-primary: #ffffff;
            --radius-sm: 0.25rem;
            --radius-default: 0.5rem;
            --radius-lg: 1rem;
            --radius-xl: 1.5rem;
            --radius-full: 9999px;
            --font-display: 'Playfair Display', serif;
            --font-body: 'Plus Jakarta Sans', sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-surface);
            color: var(--on-surface);
            font-family: var(--font-body);
            font-size: 14px;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }

        /* Top Navigation Header */
        header {
            background: var(--surface-container-lowest);
            border-bottom: 1px solid var(--surface-container-high);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-container {
            max-width: 1240px;
            margin: 0 auto;
            padding: 0.875rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand-logo h1 {
            font-family: var(--font-display);
            font-size: 18px;
            font-weight: 600;
            color: var(--on-surface);
        }

        .brand-logo span {
            display: block;
            font-family: var(--font-body);
            font-size: 10px;
            color: var(--outline);
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        nav.main-nav {
            display: flex;
            gap: 1.5rem;
        }

        nav.main-nav a {
            text-decoration: none;
            color: var(--on-surface-variant);
            font-size: 14px;
            font-weight: 500;
            padding: 0.4rem 0.8rem;
            border-radius: var(--radius-full);
            transition: all 0.2s ease;
        }

        nav.main-nav a:hover, nav.main-nav a.active {
            background-color: var(--surface-container-highest);
            color: var(--on-surface);
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .btn-header {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.5rem 1rem;
            border-radius: var(--radius-full);
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            border: 1px solid var(--outline-variant);
            color: var(--on-surface);
            background: var(--surface-container-lowest);
            transition: background 0.2s;
        }

        .btn-header:hover {
            background: var(--surface-container-low);
        }

        .btn-header-dark {
            background: var(--primary);
            color: #ffffff;
            border: none;
        }

        .btn-header-dark:hover {
            background: #333333;
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            background: var(--surface-container-highest);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }

        /* Breadcrumb */
        .breadcrumb-container {
            max-width: 1240px;
            margin: 1.5rem auto 0 auto;
            padding: 0 1.5rem;
            font-size: 12px;
            color: var(--outline);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .breadcrumb-container a {
            color: var(--outline);
            text-decoration: none;
        }

        /* Layout Grid */
        .main-wrapper {
            max-width: 1240px;
            margin: 1.5rem auto 4rem auto;
            padding: 0 1.5rem;
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 2rem;
        }

        /* Left Column Content */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--surface-container-lowest);
            border: 1px solid var(--outline-variant);
            border-radius: var(--radius-full);
            padding: 0.25rem 0.75rem;
            font-size: 12px;
            color: var(--on-surface-variant);
            margin-bottom: 1rem;
        }

        .status-badge .dot {
            width: 8px;
            height: 8px;
            background-color: #22c55e;
            border-radius: 50%;
        }

        .page-title {
            font-family: var(--font-display);
            font-size: 38px;
            font-weight: 600;
            line-height: 1.2;
            margin-bottom: 0.75rem;
            letter-spacing: -0.015em;
        }

        .page-description {
            font-size: 15px;
            color: var(--on-surface-variant);
            max-width: 680px;
            margin-bottom: 2.5rem;
            line-height: 1.6;
        }

        /* Section Container Cards */
        .step-section {
            background: var(--surface-container-lowest);
            border: 1px solid var(--outline-variant);
            border-radius: var(--radius-lg);
            padding: 1.75rem;
            margin-bottom: 2rem;
        }

        .step-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.5rem;
        }

        .step-title-group {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .step-number {
            width: 28px;
            height: 28px;
            background: var(--primary);
            color: #ffffff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 600;
        }

        .step-title {
            font-family: var(--font-display);
            font-size: 22px;
            font-weight: 500;
        }

        .step-indicator {
            font-size: 12px;
            color: var(--outline);
            font-weight: 600;
            letter-spacing: 0.05em;
        }

        /* Option Cards (Grid format) */
        .option-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .option-card {
            border: 1px solid var(--outline-variant);
            border-radius: var(--radius-default);
            padding: 1.25rem;
            cursor: pointer;
            position: relative;
            transition: all 0.2s ease;
            background: var(--surface-container-lowest);
        }

        .option-card:hover {
            border-color: var(--primary);
        }

        .option-card.selected {
            border-color: var(--primary);
            background-color: var(--surface-container-low);
        }

        .option-badge {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: var(--surface-container-highest);
            font-size: 11px;
            padding: 0.15rem 0.5rem;
            border-radius: var(--radius-sm);
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .option-card.selected .option-badge {
            background: var(--primary);
            color: #fff;
        }

        .option-card-title {
            font-size: 15px;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .option-card-subtitle {
            font-size: 12.5px;
            color: var(--on-surface-variant);
            line-height: 1.4;
        }

        /* Calendar Day Selector */
        .days-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 0.5rem;
            margin-bottom: 1.5rem;
        }

        .day-card {
            border: 1px solid var(--outline-variant);
            border-radius: var(--radius-default);
            padding: 0.75rem 0.25rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
            background: var(--surface-container-lowest);
        }

        .day-card.disabled {
            opacity: 0.35;
            cursor: not-allowed;
            border-color: transparent;
            background: var(--surface-container-low);
        }

        .day-card.selected {
            border-color: var(--primary);
            background: var(--primary);
            color: #ffffff;
        }

        .day-card.selected .day-name, .day-card.selected .day-sub {
            color: #ffffff;
        }

        .day-name {
            font-size: 11px;
            color: var(--outline);
            text-transform: uppercase;
            font-weight: 600;
            margin-bottom: 0.25rem;
        }

        .day-number {
            font-size: 18px;
            font-weight: 600;
        }

        .day-sub {
            font-size: 10px;
            color: var(--outline);
            margin-top: 0.25rem;
        }

        /* Time Slots Grid */
        .slot-title {
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: var(--outline);
            margin-bottom: 0.75rem;
        }

        .slots-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 0.5rem;
        }

        .slot-btn {
            border: 1px solid var(--outline-variant);
            background: var(--surface-container-lowest);
            padding: 0.6rem 0;
            border-radius: var(--radius-default);
            font-size: 13px;
            font-weight: 500;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .slot-btn:hover {
            border-color: var(--primary);
        }

        .slot-btn.selected {
            background: var(--primary);
            color: #ffffff;
            border-color: var(--primary);
        }

        /* Form Controls */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
        }

        .form-group.full-width {
            grid-column: span 2;
        }

        label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--on-surface-variant);
        }

        input[type="text"], input[type="email"], select, textarea {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid var(--outline-variant);
            border-radius: var(--radius-default);
            font-family: var(--font-body);
            font-size: 14px;
            color: var(--on-surface);
            background: var(--surface-container-lowest);
            outline: none;
            transition: border-color 0.2s;
        }

        input:focus, select:focus, textarea:focus {
            border-color: var(--primary);
        }

        textarea {
            resize: vertical;
            min-height: 80px;
        }

        /* Summary Box & CTA */
        .summary-box {
            background: var(--surface-container-low);
            border-radius: var(--radius-default);
            padding: 1.25rem;
            margin-top: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .summary-info {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .summary-icon {
            width: 36px;
            height: 36px;
            background: var(--surface-container-highest);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .summary-details h5 {
            font-size: 14px;
            font-weight: 600;
        }

        .summary-details p {
            font-size: 12px;
            color: var(--outline);
        }

        .live-tag {
            font-size: 11px;
            color: var(--outline);
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        .btn-submit {
            width: 100%;
            background: var(--primary);
            color: #ffffff;
            border: none;
            padding: 1rem;
            border-radius: var(--radius-full);
            font-family: var(--font-body);
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            transition: opacity 0.2s;
            text-decoration: none;
        }

        .btn-submit:hover {
            opacity: 0.9;
        }

        .disclaimer-text {
            font-size: 11px;
            color: var(--outline);
            text-align: center;
            margin-top: 0.75rem;
        }

        /* Right Sidebar Componentry */
        .sidebar-card {
            background: var(--surface-container-lowest);
            border: 1px solid var(--outline-variant);
            border-radius: var(--radius-lg);
            padding: 1.25rem;
            margin-bottom: 1.5rem;
        }

        .feature-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .feature-item {
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
        }

        .feature-icon {
            width: 32px;
            height: 32px;
            background: var(--surface-container-low);
            border-radius: var(--radius-default);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 14px;
        }

        .feature-text h6 {
            font-size: 13px;
            font-weight: 600;
        }

        .feature-text p {
            font-size: 11.5px;
            color: var(--outline);
        }

        /* Profile Widget */
        .profile-widget {
            display: flex;
            align-items: center;
            gap: 0.875rem;
            margin-bottom: 1rem;
        }

        .profile-avatar {
            width: 54px;
            height: 54px;
            border-radius: 50%;
            object-fit: cover;
            background: #ddd;
        }

        .profile-info h4 {
            font-family: var(--font-display);
            font-size: 17px;
            font-weight: 600;
        }

        .profile-info p {
            font-size: 12px;
            color: var(--outline);
        }

        .profile-bio {
            font-size: 12.5px;
            color: var(--on-surface-variant);
            line-height: 1.5;
            margin-bottom: 1rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--surface-container-high);
        }

        .working-hours {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            font-size: 12px;
        }

        .working-row {
            display: flex;
            justify-content: space-between;
            color: var(--on-surface-variant);
        }

        /* Map & Contact */
        .contact-info-list {
            display: flex;
            flex-direction: column;
            gap: 0.875rem;
            font-size: 12.5px;
            margin-bottom: 1rem;
        }

        .contact-item {
            display: flex;
            gap: 0.6rem;
            align-items: flex-start;
        }

        .map-box {
            width: 100%;
            height: 120px;
            background-color: var(--surface-container-highest);
            border-radius: var(--radius-default);
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            background-image: linear-gradient(135deg, #e2e2e2 25%, #d0d0d0 25%, #d0d0d0 50%, #e2e2e2 50%, #e2e2e2 75%, #d0d0d0 75%, #d0d0d0 100%);
            background-size: 20px 20px;
        }

        .btn-map {
            position: absolute;
            background: var(--surface-container-lowest);
            padding: 0.4rem 0.8rem;
            border-radius: var(--radius-full);
            font-size: 11px;
            font-weight: 600;
            border: 1px solid var(--outline-variant);
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
            text-decoration: none;
            color: var(--on-surface);
        }

        /* Accordions / FAQ Section */
        .faq-title {
            font-family: var(--font-display);
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .accordion-item {
            border: 1px solid var(--outline-variant);
            border-radius: var(--radius-default);
            margin-bottom: 0.5rem;
            overflow: hidden;
            background: var(--surface-container-lowest);
        }

        .accordion-header {
            padding: 0.875rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
            user-select: none;
        }

        .accordion-header:hover {
            background-color: var(--surface-container-low);
        }

        .accordion-icon {
            transition: transform 0.2s ease;
            font-size: 12px;
        }

        .accordion-item.open .accordion-icon {
            transform: rotate(180deg);
        }

        .accordion-content {
            padding: 0 1rem 0.875rem 1rem;
            font-size: 12px;
            color: var(--on-surface-variant);
            line-height: 1.5;
            display: none;
            border-top: 1px solid var(--surface-container);
            padding-top: 0.75rem;
        }

        .accordion-item.open .accordion-content {
            display: block;
        }

        /* Footer */
        footer {
            background: var(--surface-container-lowest);
            border-top: 1px solid var(--surface-container-high);
            padding: 3rem 1.5rem 1.5rem 1.5rem;
            margin-top: 4rem;
        }

        .footer-container {
            max-width: 1240px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            gap: 2rem;
            padding-bottom: 2rem;
            border-bottom: 1px solid var(--surface-container-high);
        }

        .footer-col h6 {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: var(--outline);
            margin-bottom: 0.875rem;
        }

        .footer-links {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .footer-links a {
            text-decoration: none;
            font-size: 13px;
            color: var(--on-surface-variant);
        }

        .footer-links a:hover {
            color: var(--on-surface);
        }

        .footer-bottom {
            max-width: 1240px;
            margin: 1.5rem auto 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 11px;
            color: var(--outline);
        }

        .footer-bottom-links {
            display: flex;
            gap: 1.5rem;
        }

        .footer-bottom-links a {
            color: var(--outline);
            text-decoration: none;
        }

        /* Responsive Breakpoints */
        @media (max-width: 1024px) {
            .main-wrapper {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 640px) {
            .option-grid, .form-grid {
                grid-template-columns: 1fr;
            }
            .form-group.full-width {
                grid-column: span 1;
            }
            .slots-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            nav.main-nav {
                display: none;
            }
        }
    </style>
</head>
<body>

    <!-- Header Navigation -->
    <header>
        <div class="header-container">
            <div class="brand-logo">
                <h1>Dyt. Havva Nur Esen</h1>
                <span>Özel Sağlık Meslek Hizmet Birimi</span>
            </div>
            <nav class="main-nav">
                <a href="index.html">Ana Sayfa</a>
                <a href="index.html#hizmetler">Hizmetler</a>
                <a href="randevu.html" class="active">Online Randevu</a>
                <a href="index.html#iletisim">İletişim</a>
            </nav>
            <div class="header-actions">
                <a href="https://wa.me/905303661720" target="_blank" class="btn-header">💬 WHATSAPP</a>
                <a href="index.html" class="btn-header btn-header-dark">← Ana Sayfaya Dön</a>
                <div class="user-avatar">👤</div>
            </div>
        </div>
    </header>

    <!-- Breadcrumb -->
    <div class="breadcrumb-container">
        <a href="index.html">ANA SAYFA</a> &nbsp;/&nbsp; RANDEVU PLANLAMA
    </div>

    <!-- Main Container -->
    <main class="main-wrapper">
        
        <!-- Left Section (Booking Steps) -->
        <section class="booking-content">
            
            <div class="status-badge">
                <span class="dot"></span>
                <span>Klinik Seans Takvimi Aktif</span>
            </div>

            <h2 class="page-title">Randevu & Seans Planlama</h2>
            <p class="page-description">
                Diyetisyen Havva Nur Esen rehberliğinde metabolik ve fonksiyonel beslenme sürecinize ilk adımı atın. Seans türünü, uygun gün ve saati seçerek randevu talebinizi hemen iletebilirsiniz.
            </p>

            <!-- Step 1: Görüşme Formatı Seçimi -->
            <div class="step-section">
                <div class="step-header">
                    <div class="step-title-group">
                        <span class="step-number">1</span>
                        <h3 class="step-title">Görüşme Formatı Seçimi</h3>
                    </div>
                    <span class="step-indicator">ADIM 1/4</span>
                </div>

                <div class="option-grid">
                    <div class="option-card" onclick="selectOption(this, 'Online Danışmanlık (Global)')">
                        <div class="option-card-title">Online Danışmanlık (Global)</div>
                        <div class="option-card-subtitle">Google Meet / Zoom ya da Sesli & WhatsApp için alındığı yerden katılın</div>
                    </div>

                    <div class="option-card selected" onclick="selectOption(this, 'Yüz Yüze Görüşme (Klinik)')">
                        <span class="option-badge">SEÇİLDİ</span>
                        <div class="option-card-title">Yüz Yüze Görüşme (Klinik)</div>
                        <div class="option-card-subtitle">Serdivan / Sakarya klinik ofisinde detaylı vücut analizi ile görüşme yapılır</div>
                    </div>
                </div>
            </div>

            <!-- Step 2: Tarih ve Gün Tercihi -->
            <div class="step-section">
                <div class="step-header">
                    <div class="step-title-group">
                        <span class="step-number">2</span>
                        <h3 class="step-title">Tarih ve Gün Tercihi</h3>
                    </div>
                    <span class="step-indicator">EKİM 2026</span>
                </div>

                <div class="slot-title">MÜSAİT GÜNLER</div>
                <div class="days-grid">
                    <div class="day-card selected" onclick="selectDay(this, 'Perşembe (8 Eki)')">
                        <div class="day-name">PER</div>
                        <div class="day-number">8</div>
                        <div class="day-sub">Eki</div>
                    </div>
                    <div class="day-card" onclick="selectDay(this, 'Cuma (9 Eki)')">
